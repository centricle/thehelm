# The Helm — Configuration
# Copy this to .env and fill in your values.

# ─── Mode ────────────────────────────────────────────────────
# Set to "true" to show ACME Corp demo data instead of live API calls.
# DEMO_MODE=true

# ─── Sites to monitor (HTTP HEAD checks) ────────────────────
# Format: Name|URL,Name|URL
# HELM_SITES=My App|https://myapp.com,Blog|https://blog.example.com

# ─── Netlify (deploy history) ───────────────────────────────
# Personal access token from https://app.netlify.com/user/applications#personal-access-tokens
# NETLIFY_AUTH_TOKEN=

# Format: Name|SiteID,Name|SiteID
# Find site IDs: netlify sites:list or Netlify dashboard > Site settings > General
# HELM_NETLIFY_SITES=My App|xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── GitHub (git activity) ──────────────────────────────────
# Personal access token with repo scope: https://github.com/settings/tokens
# GITHUB_TOKEN=

# Format: Name|owner/repo,Name|owner/repo
# HELM_GITHUB_REPOS=My App|myorg/myapp,Blog|myorg/blog

# ─── Server ─────────────────────────────────────────────────
# PORT=7040
