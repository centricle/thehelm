<div class="py-4 text-sm" role="alert">
  <div class="flex items-start gap-2 text-error">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <div>
      <p class="font-medium"><%= typeof title !== 'undefined' ? title : 'Something went wrong' %></p>
      <% if (typeof detail !== 'undefined') { %>
        <p class="text-fg-faint mt-1 text-xs"><%= detail %></p>
      <% } %>
    </div>
  </div>
</div>
