<header class="border-b border-border bg-bg-surface/50 backdrop-blur-sm">
  <nav class="max-w-7xl mx-auto px-4 pt-3.5 pb-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 text-fg hover:text-primary transition-colors">
      <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="28" height="28" rx="6" fill="#151618" stroke="#252629"/>
        <circle cx="16" cy="16" r="8" stroke="#4892a8" stroke-width="1.5" fill="none"/>
        <circle cx="16" cy="16" r="3" stroke="#4892a8" stroke-width="1.5" fill="none"/>
        <line x1="16" y1="8" x2="16" y2="5" stroke="#4892a8" stroke-width="1.5"/>
        <line x1="16" y1="27" x2="16" y2="24" stroke="#4892a8" stroke-width="1.5"/>
        <line x1="8" y1="16" x2="5" y2="16" stroke="#4892a8" stroke-width="1.5"/>
        <line x1="27" y1="16" x2="24" y2="16" stroke="#4892a8" stroke-width="1.5"/>
      </svg>
      <span class="font-semibold text-base tracking-wide">The Helm</span>
      <% if (isDemoMode) { %>
        <span class="badge badge-building text-xs leading-none py-0.5">DEMO</span>
      <% } %>
    </a>

    <div class="hidden md:flex items-center gap-6 text-base">
      <a href="/" class="text-fg-muted hover:text-fg transition-colors">Dashboard</a>
      <a href="/about" class="text-fg-muted hover:text-fg transition-colors">About</a>
      <a href="https://github.com/centricle/thehelm" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors flex items-center gap-1">
        GitHub
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>

    <button id="menu-btn" class="md:hidden text-fg-muted hover:text-fg p-1" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden border-t border-border bg-bg-surface">
    <div class="px-4 py-3 space-y-2">
      <a href="/" class="block text-base text-fg-muted hover:text-fg">Dashboard</a>
      <a href="/about" class="block text-base text-fg-muted hover:text-fg">About</a>
      <a href="https://github.com/centricle/thehelm" target="_blank" rel="noopener" class="block text-base text-fg-muted hover:text-fg">GitHub</a>
    </div>
  </div>
</header>
